<Window x:Class="ZyroMoney_DESKTOP.AddCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Tarjeta de Crédito" Height="480" Width="420"
        Background="#111827" Foreground="#F3F4F6"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Nueva Tarjeta de Crédito" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="Configura los límites y fechas de ciclo de tu tarjeta." FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,20"/>

            <!-- Nombre de la Tarjeta -->
            <TextBlock Text="Nombre del Banco / Tarjeta (Ej. BHD, Qik, Popular)" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Background="#1F2937" Foreground="#FFFFFF" BorderBrush="#374151" Padding="8" Height="36" Margin="0,0,0,12"/>

            <!-- Moneda y Límite en 2 columnas -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Moneda" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbCurrency" Height="36" SelectedIndex="0" Background="#1F2937" Foreground="#111827">
                        <ComboBoxItem Content="DOP"/>
                        <ComboBoxItem Content="USD"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Límite de Crédito" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtLimit" Background="#1F2937" Foreground="#FFFFFF" BorderBrush="#374151" Padding="8" Height="36"/>
                </StackPanel>
            </Grid>

            <!-- Balance Inicial -->
            <TextBlock Text="Balance Actual / Deuda Inicial (Opcional)" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtInitialBalance" Text="0.00" Background="#1F2937" Foreground="#FFFFFF" BorderBrush="#374151" Padding="8" Height="36" Margin="0,0,0,12"/>

            <!-- Día de Corte y Día de Pago -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Día de Corte (1-31)" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtClosingDay" Background="#1F2937" Foreground="#FFFFFF" BorderBrush="#374151" Padding="8" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Días límite después del corte (ej. 20)" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDueDay" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334151" Padding="8" Height="36"/>
                </StackPanel>
            </Grid>

            <!-- Botones -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Height="40" Margin="0,0,8,0"
                        Background="#374151" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                        Click="BtnCancel_Click"/>

                <Button Grid.Column="1" Content="Guardar Tarjeta" Height="40" Margin="8,0,0,0"
                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnSave_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>