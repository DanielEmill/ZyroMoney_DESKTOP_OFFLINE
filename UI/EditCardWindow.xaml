<Window x:Class="ZyroMoney_DESKTOP.EditCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Tarjeta" Height="430" Width="420"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Editar Tarjeta" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="Modifica los parámetros de tu tarjeta de crédito." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,20"/>

            <!-- Nombre -->
            <TextBlock Text="Nombre de la Tarjeta" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334151" Padding="8" Height="36" Margin="0,0,0,12"/>

            <!-- Límite -->
            <TextBlock Text="Límite de Crédito" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLimit" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334151" Padding="8" Height="36" Margin="0,0,0,12"/>

            <!-- Días (Corte y Gracia) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Día de Corte" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtClosingDay" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334151" Padding="8" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Días después corte" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDueDay" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334151" Padding="8" Height="36"/>
                </StackPanel>
            </Grid>

            <!-- Botones -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Height="40" Margin="0,0,8,0"
                        Background="#334151" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                        Click="BtnCancel_Click"/>

                <Button Grid.Column="1" Content="Guardar Cambios" Height="40" Margin="8,0,0,0"
                        Background="#38BDF8" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnSave_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>