<Window x:Class="ZyroMoney_DESKTOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZyroMoney Desktop - Finanzas Offline" Height="600" Width="900"
        Background="#111827" Foreground="#F3F4F6" WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="ZyroMoney" FontSize="24" FontWeight="Bold" Foreground="#34D399"/>
            <TextBlock Text=" • Escritorio Local" FontSize="24" FontWeight="Light" Foreground="#9CA3AF" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Contenido Central -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Información y Estado de la BD -->
            <Border Grid.Column="0" Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Estado del Sistema" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                    <TextBlock x:Name="TxtUserStatus" Text="Cargando perfil local..." FontSize="14" Foreground="#9CA3AF" Margin="0,0,0,15"/>

                    <Button Content="🔄 Probar Conexión con SQLite" 
                            Background="#374151" Foreground="#FFFFFF" FontWeight="Medium" 
                            Height="38" Cursor="Hand" BorderThickness="0"
                            Click="BtnTestDb_Click"/>
                </StackPanel>
            </Border>

            <!-- Panel Derecho: Acciones Rápidas -->
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#1F2937" CornerRadius="10" Padding="20" BorderBrush="#374151" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Acciones" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                    <Button Content="💳 Gestionar Tarjetas" 
                            Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" 
                            Height="40" Margin="0,0,0,10" Cursor="Hand" BorderThickness="0"/>

                    <Button Content="📋 Ver Deudas" 
                            Background="#374151" Foreground="#FFFFFF" FontWeight="Medium" 
                            Height="40" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="Transparent" Foreground="#9CA3AF">
            <StatusBarItem Content="Base de datos SQLite activa en AppData/Local/ZyroMoneyDesktop"/>
        </StatusBar>
    </Grid>
</Window>