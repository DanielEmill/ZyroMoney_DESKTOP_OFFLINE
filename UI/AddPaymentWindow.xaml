<Window x:Class="ZyroMoney_DESKTOP.AddPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Registrar Pago a Tarjeta" Height="500" Width="420"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Abonar a Tarjeta" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="Registra un pago para reducir el balance pendiente." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

            <!-- Selector de Tarjeta -->
            <TextBlock Text="Tarjeta a Pagar" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbCards" Height="36" Margin="0,0,0,12"
                      SelectedValuePath="CreditCardId"
                      SelectionChanged="PaymentSelection_Changed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Monto y Tipo de Pago -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Monto del Abono" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtAmount" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334151" Padding="8" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Tipo de Pago" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbPaymentType" Height="36" SelectedIndex="0"
                              SelectionChanged="PaymentSelection_Changed">
                        <ComboBoxItem Content="Parcial"/>
                        <ComboBoxItem Content="Total / Al Corte"/>
                        <ComboBoxItem Content="Mínimo"/>
                        <ComboBoxItem Content="Extraordinario"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Fecha del Pago -->
            <TextBlock Text="Fecha del Pago" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpPaymentDate" Height="36" Margin="0,0,0,12" 
                        Background="#1E293B" Foreground="#0F172A" SelectedDate="{x:Static sys:DateTime.Today}"/>

            <!-- Notas Opcionales -->
            <TextBlock Text="Notas / Referencia (Opcional)" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtNotes" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334151" Padding="8" Height="36" Margin="0,0,0,20"/>

            <!-- Botones -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Height="40" Margin="0,0,8,0"
                        Background="#334151" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                        Click="BtnCancel_Click"/>

                <Button Grid.Column="1" Content="Registrar Pago" Height="40" Margin="8,0,0,0"
                        Background="#38BDF8" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnSave_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>